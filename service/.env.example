APP_NAME=PEKA Service
DEBUG=false
DATABASE_URL=postgresql://peka:peka_dev_password@localhost:5432/peka
FILE_STORAGE_DIR=storage
# LLAMA_* names are no longer supported; use LLM_* names.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=replace-with-your-local-llm-key
LLM_MODEL=local
LLM_MAX_TOKENS=8192
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=1
SEARCH_TOP_K=5
SEARCH_SIMILARITY_FLOOR=0.3
# Optional public web search. Leave EXA_API_KEY empty to disable it.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT=20
# Generate random secret (32+ chars); placeholder is rejected by config.
JWT_SECRET_KEY=nbbNhaVlisEgbNH3YAQ8FMr4IezvSMOMmB5vuynWf5g=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=peka-service
JWT_AUDIENCE=peka-api
# Optional one-time bootstrap. Set both only when creating first admin; never commit values.
ADMIN_EMAIL=admin@peka.com
ADMIN_PASSWORD=PEKA_GOAT67@123
