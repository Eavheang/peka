APP_NAME=PEKA Service
DEBUG=false
DATABASE_URL=postgresql://peka:peka_dev_password@localhost:5432/peka
FILE_STORAGE_DIR=storage
# LLAMA_* names are no longer supported; use LLM_* names.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=replace-with-your-local-llm-key
LLM_MODEL=local
LLM_MAX_TOKENS=8192
# Optional OKF enrichment: after a file is searchable, also write an LLM summary page to storage/knowledge_base/.
# Search and citations never use it. It sends each whole document to the LLM above and competes with chat there.
OKF_ENRICHMENT_ENABLED=false
OKF_MAX_TOKENS=32768
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=1
# Results returned by POST /search. Chat prompts get RERANK_TOP_K instead.
SEARCH_TOP_K=10
SEARCH_SIMILARITY_FLOOR=0.3
# Local cross-encoder. If it is unreachable, search logs a warning and keeps the hybrid order.
RERANK_BASE_URL=http://localhost:8082
# Hybrid hits scored per query. TEI rejects more than 32 by default, which means no reranking.
RERANK_CANDIDATES=20
RERANK_TOP_K=5
# Optional public web search. Leave EXA_API_KEY empty to disable it.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT=20
# Generate random secret (32+ chars); placeholder is rejected by config.
JWT_SECRET_KEY=nbbNhaVlisEgbNH3YAQ8FMr4IezvSMOMmB5vuynWf5g=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=peka-service
JWT_AUDIENCE=peka-api
# Invitation emails. Leave SMTP_HOST empty to disable sending; admins can still copy the invite link.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, and a Google "app password" (needs 2-step verification).
APP_BASE_URL=http://localhost:3000
INVITATION_EXPIRE_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google Drive import. Leave GOOGLE_CLIENT_ID empty to disable it.
# Client ID/secret: Google Cloud > APIs & Services > Credentials > OAuth client (Web application).
# API key: same page > Create credentials > API key (restrict to Google Picker API + Google Drive API).
# App ID: the project number from IAM & Admin > Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Optional one-time bootstrap. Set both only when creating first admin; never commit values.
ADMIN_EMAIL=admin@peka.com
ADMIN_PASSWORD=PEKA_GOAT67@123
