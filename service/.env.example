# Only what an install has to decide. Every other option has a safe default in app/config.py
# and is listed in docs/service/README.md.

# Required: a random secret of at least 32 characters. The app refuses to start with this placeholder.
# Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Local model in Compose. A hosted model needs its own URL, name and LLM_API_KEY.
# Running the API on the host instead of in Compose? Use http://localhost:8080/v1.
LLM_BASE_URL=http://llama:8080/v1
LLM_MODEL=local
# LLM_API_KEY=

# Creates the first admin. Set both once, using your own values, and never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The address people open the app at. Invitation links use it.
APP_BASE_URL=http://localhost:3000

# Optional public web search. Leave EXA_API_KEY empty to disable it.
EXA_API_KEY=

# Invitation emails. Leave SMTP_HOST empty to disable sending; admins can still copy the invite link.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, and a Google "app password" (needs 2-step verification).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google Drive import. Leave GOOGLE_CLIENT_ID empty to disable it.
# Client ID/secret: Google Cloud > APIs & Services > Credentials > OAuth client (Web application).
# API key: same page > Create credentials > API key (restrict to Google Picker API + Google Drive API).
# App ID: the project number from IAM & Admin > Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
